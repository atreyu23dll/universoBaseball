              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bounds",
          "type": "array"
        },
        "role": {
          "default": "symbol",
          "enum": [
            "symbol",
            "lettering",
            "ornament",
            "container"
          ],
          "title": "Role",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "d"
      ],
      "title": "PathLayer",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "description": "Dónde, cuánto y con qué giro se dibuja una capa.",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/Anchor",
          "default": "center"
        },
        "dx": {
          "default": 0.0,
          "maximum": 100.0,
          "minimum": -100.0,
          "title": "Dx",
          "type": "number"
        },
        "dy": {
          "default": 0.0,
          "maximum": 100.0,
          "minimum": -100.0,
          "title": "Dy",
          "type": "number"
        },
        "scale": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 2.0,
          "title": "Scale",
          "type": "number"
        },
        "rotate": {
          "default": 0.0,
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Rotate",
          "type": "number"
        }
      },
      "title": "Placement",
      "type": "object"
    },
    "Shape": {
      "description": "Siluetas de soporte y de marco. Geometría, no dibujo.",
      "enum": [
        "shield",
        "circle",
        "diamond",
        "square",
        "hexagon",
        "banner",
        "triangle",
        "ring",
        "arch"
      ],
      "title": "Shape",
      "type": "string"
    },
    "ShapeLayer": {
      "additionalProperties": false,
      "description": "Una silueta: el soporte del escudo o un marco por encima.",
