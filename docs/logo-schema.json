          "title": "Stroke Width",
          "type": "number"
        },
        "opacity": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Opacity",
          "type": "number"
        },
        "min_size": {
          "default": 0,
          "maximum": 512,
          "minimum": 0,
          "title": "Min Size",
          "type": "integer"
        },
        "kind": {
          "const": "path",
          "default": "path",
          "title": "Kind",
          "type": "string"
        },
        "d": {
          "maxLength": 150000,
          "minLength": 1,
          "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9eE., +\\-\\n]+$",
          "title": "D",
          "type": "string"
        },
        "bounds": {
          "default": [
            0,
            0,
            100,
