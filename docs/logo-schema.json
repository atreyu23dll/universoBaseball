    "TextLayout": {
      "description": "Topología del texto: la forma en que las letras se colocan.\n\nNo es solo la tipografía: `ARC` curva el nombre sobre el escudo, `STACKED`\nlo parte en líneas y `VERTICAL` lo pone en columna. Es lo que distingue un\nmonograma de una marca verbal.",
      "enum": [
        "straight",
        "arc",
        "arc_below",
        "stacked",
        "vertical"
      ],
      "title": "TextLayout",
      "type": "string"
    },
    "Typography": {
      "enum": [
        "block",
        "slab",
        "script",
        "condensed",
        "geometric"
      ],
      "title": "Typography",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Un logo completo: paleta, capas y por qué es así.\n\n`rationale` no es decoración: es la traza de qué decidió esta identidad —el\nlugar, el concepto del nombre, la personalidad de quien manda— y sin ella\nun logo generado es indistinguible de uno aleatorio.",
  "properties": {
    "design_style": {
      "default": "legacy",
      "title": "Design Style",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "variant": {
      "default": "primary",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$",
      "title": "Variant",
      "type": "string"
    },
    "palette": {
      "$ref": "#/$defs/Palette"
    },
    "layers": {
      "items": {
        "discriminator": {
          "mapping": {
            "motif": "#/$defs/MotifLayer",
            "path": "#/$defs/PathLayer",
            "shape": "#/$defs/ShapeLayer",
            "text": "#/$defs/TextLayer"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ShapeLayer"
          },
          {
            "$ref": "#/$defs/MotifLayer"
          },
          {
            "$ref": "#/$defs/TextLayer"
          },
          {
            "$ref": "#/$defs/PathLayer"
          }
        ]
      },
      "maxItems": 12,
      "title": "Layers",
      "type": "array"
    },
    "root": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompositionNode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rationale": {
      "default": "",
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "palette"
  ],
  "title": "LogoSpec",
  "type": "object"
}
