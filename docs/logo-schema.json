            "rotate": 0.0
          }
        },
        "fill": {
          "default": "mark",
          "pattern": "^(field|mark|ink|accent|paper|shade|tint|metal|none|#[0-9A-Fa-f]{6})$",
          "title": "Fill",
          "type": "string"
        },
        "stroke": {
          "default": "none",
          "pattern": "^(field|mark|ink|accent|paper|shade|tint|metal|none|#[0-9A-Fa-f]{6})$",
          "title": "Stroke",
          "type": "string"
        },
        "stroke_width": {
