      "type": "object"
    },
    "TextLayer": {
      "additionalProperties": false,
      "description": "Letras: un monograma, unas iniciales o el nombre entero.",
      "properties": {
        "z": {
          "default": 0,
          "maximum": 100,
          "minimum": -100,
          "title": "Z",
          "type": "integer"
        },
        "placement": {
          "$ref": "#/$defs/Placement",
          "default": {
            "anchor": "center",
            "dx": 0.0,
