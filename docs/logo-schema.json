        },
        "min_size": {
          "default": 0,
          "maximum": 512,
          "minimum": 0,
          "title": "Min Size",
          "type": "integer"
        },
        "kind": {
          "const": "shape",
          "default": "shape",
          "title": "Kind",
          "type": "string"
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        }
      },
      "required": [
        "shape"
