# Copia este archivo a `.env` y ajusta lo que necesites. `.env` NO va a git.
# Ningún valor de aquí es un secreto real.

# --- Base de datos --------------------------------------------------------- #
# PostgreSQL es el modo de referencia (lo que usa docker compose):
# BU_DATABASE_URL=postgresql+psycopg://baseball:baseball_local@127.0.0.1:5433/baseball_universe
# SQLite es el modo de arranque cero, sin infraestructura:
BU_DATABASE_URL=sqlite+pysqlite:///./data/baseball.db

# Contraseña de PostgreSQL en docker compose. Cámbiala si expones el puerto.
BU_DB_PASSWORD=baseball_local

# --- Servidor -------------------------------------------------------------- #
# Ligado a loopback a propósito. Ponlo en 0.0.0.0 solo si sabes lo que haces.
BU_HOST=127.0.0.1
BU_PORT=8000
BU_LOG_LEVEL=INFO

# --- Simulación ------------------------------------------------------------ #
# Tope de días que un solo comando de avance puede recorrer.
BU_MAX_ADVANCE_DAYS=400
# Guardar el detalle turno a turno de cada partido multiplica el tamaño de la
# base. Ponlo en false para universos de muchas temporadas.
BU_STORE_GAME_EVENTS=true
BU_DEFAULT_CURRENCY=MXN
BU_SQL_ECHO=false
